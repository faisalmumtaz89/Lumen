            float scale = float(as_type<half>(*(device const ushort*)bp));
            device const uchar* qdata = (device const uchar*)(bp + 2) + il * 4;

            float sumq = 0.f;
            float syl = 0.f;
            #pragma clang loop unroll(full)
            for (uint i = 0; i < 4; ++i) {
                uchar byte_val = qdata[i];
                sumq += float(byte_val & 0x0F) * yl_lo[i] + float(byte_val >> 4) * yl_hi[i];
                syl += yl_lo[i] + yl_hi[i];
            }
            // Fold Q4_0 -8 zero-point: dot((q-8),yl) = dot(q,yl) - 8*sum(yl).
            sumf[row] += (sumq - 8.0f * syl) * scale;
