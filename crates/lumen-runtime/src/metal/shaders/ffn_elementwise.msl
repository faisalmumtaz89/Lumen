kernel void add_write(
    device const float* a   [[buffer(0)]],
    device const float* b   [[buffer(1)]],
    device float*       out [[buffer(2)]],
    uint gid                [[thread_position_in_grid]])
{
    out[gid] = a[gid] + b[gid];
}

kernel void copy_buffer(
    device const float* src [[buffer(0)]],
    device float*       dst [[buffer(1)]],
    uint gid                [[thread_position_in_grid]])
{
    dst[gid] = src[gid];
}

// ============================================================================
// ffn_fused_gate_up_swiglu_q8_0: Fused Gate+Up+SwiGLU for decode
//
// Fuses 3 operations into a single dispatch:
//   Phase 1: Gate matmul (Q8_0 dequant, reads normed x from device memory)
//   Phase 2: Up matmul (Q8_0 dequant, reads normed x from device memory)
//   Phase 3: SwiGLU (gate * sigmoid(gate) * up) -> write to out
//
// Eliminates:
//   - 1 encoder barrier between gate/up and swiglu dispatches
//   - Device memory write of up_buf (22KB) -- up goes directly to SwiGLU
//   - Device memory read of gate_buf by SwiGLU (22KB)
//   - Device memory read of up_buf by SwiGLU (22KB)
//   - Gate and up values stay in registers, never touch device memory
//
// Dispatch: ceil(inter_dim/4) threadgroups, 128 threads each (4 simdgroups)
// Each simdgroup handles 1 output row.
// Zero threadgroup memory required.
// ============================================================================

kernel void ffn_fused_gate_up_swiglu_q8_0(
    device const uchar* w_gate_q8   [[buffer(0)]],   // gate weights Q8_0 [inter_dim, hidden_dim]
    device const float* x           [[buffer(1)]],   // normed input [hidden_dim]
    device float*       out         [[buffer(2)]],   // output [inter_dim] (SwiGLU result)
    constant uint&      in_dim      [[buffer(3)]],   // hidden_dim
    constant uint&      out_dim     [[buffer(4)]],   // inter_dim
    device const uchar* w_up_q8     [[buffer(5)]],   // up weights Q8_0 [inter_dim, hidden_dim]
    uint row_group                  [[threadgroup_position_in_grid]],
    uint lane                       [[thread_index_in_simdgroup]],
    uint sg                         [[simdgroup_index_in_threadgroup]])
{
    uint row = row_group * 4 + sg;
    if (row >= out_dim) return;

    const uint Q8_BLOCK_SIZE = 34;
    uint num_blocks = in_dim >> 5;  // in_dim / 32
    uint row_bytes = num_blocks * Q8_BLOCK_SIZE;

    // --- Gate matmul: dot(w_gate[row], x) ---
    device const uchar* gate_row_ptr = w_gate_q8 + row * row_bytes;
    float gate_sum = 0.0f;

    uint b = 0;
    for (; b + 3 < num_blocks; b += 4) {
        device const uchar* bp0 = gate_row_ptr + b * Q8_BLOCK_SIZE;
        device const uchar* bp1 = bp0 + Q8_BLOCK_SIZE;
        device const uchar* bp2 = bp1 + Q8_BLOCK_SIZE;
        device const uchar* bp3 = bp2 + Q8_BLOCK_SIZE;
        half s0 = as_type<half>(*(device const ushort*)bp0);
        half s1 = as_type<half>(*(device const ushort*)bp1);
        half s2 = as_type<half>(*(device const ushort*)bp2);
        half s3 = as_type<half>(*(device const ushort*)bp3);
        float v0 = float(((device const char*)(bp0 + 2))[lane]) * x[(b << 5) + lane];
        float v1 = float(((device const char*)(bp1 + 2))[lane]) * x[((b+1) << 5) + lane];
        float v2 = float(((device const char*)(bp2 + 2))[lane]) * x[((b+2) << 5) + lane];
        float v3 = float(((device const char*)(bp3 + 2))[lane]) * x[((b+3) << 5) + lane];
        gate_sum += float(s0) * simd_sum(v0) + float(s1) * simd_sum(v1)
                  + float(s2) * simd_sum(v2) + float(s3) * simd_sum(v3);
    }
    for (; b < num_blocks; b++) {
        device const uchar* bp = gate_row_ptr + b * Q8_BLOCK_SIZE;
        half sc = as_type<half>(*(device const ushort*)bp);
        float val = float(((device const char*)(bp + 2))[lane]) * x[(b << 5) + lane];
        gate_sum += float(sc) * simd_sum(val);
    }

    // --- Up matmul: dot(w_up[row], x) ---
    device const uchar* up_row_ptr = w_up_q8 + row * row_bytes;
    float up_sum = 0.0f;

    b = 0;
    for (; b + 3 < num_blocks; b += 4) {
        device const uchar* bp0 = up_row_ptr + b * Q8_BLOCK_SIZE;
        device const uchar* bp1 = bp0 + Q8_BLOCK_SIZE;
        device const uchar* bp2 = bp1 + Q8_BLOCK_SIZE;
        device const uchar* bp3 = bp2 + Q8_BLOCK_SIZE;
        half s0 = as_type<half>(*(device const ushort*)bp0);
        half s1 = as_type<half>(*(device const ushort*)bp1);
        half s2 = as_type<half>(*(device const ushort*)bp2);
        half s3 = as_type<half>(*(device const ushort*)bp3);
        float v0 = float(((device const char*)(bp0 + 2))[lane]) * x[(b << 5) + lane];
        float v1 = float(((device const char*)(bp1 + 2))[lane]) * x[((b+1) << 5) + lane];
        float v2 = float(((device const char*)(bp2 + 2))[lane]) * x[((b+2) << 5) + lane];
        float v3 = float(((device const char*)(bp3 + 2))[lane]) * x[((b+3) << 5) + lane];
        up_sum += float(s0) * simd_sum(v0) + float(s1) * simd_sum(v1)
                + float(s2) * simd_sum(v2) + float(s3) * simd_sum(v3);
    }
    for (; b < num_blocks; b++) {
        device const uchar* bp = up_row_ptr + b * Q8_BLOCK_SIZE;
        half sc = as_type<half>(*(device const ushort*)bp);
        float val = float(((device const char*)(bp + 2))[lane]) * x[(b << 5) + lane];
        up_sum += float(sc) * simd_sum(val);
    }

    // --- SwiGLU: gate * sigmoid(gate) * up ---
    if (lane == 0) {
        float g = gate_sum;
        float sigmoid = 1.0f / (1.0f + exp(-g));
        out[row] = g * sigmoid * up_sum;
    }
}

// ============================================================================
// ffn_fused_gate_up_swiglu_q8_0_deferred: Deferred-reduction fused FFN
//
// Same computation as ffn_fused_gate_up_swiglu_q8_0 but uses a
// deferred-reduction pattern to minimize simd_sum() synchronization:
//
// Old kernel: simd_sum() on every Q8_0 block (176 calls for hidden_dim=5632)
// New kernel: each thread accumulates 8 elements locally per block, ONE
//             simd_sum() at the end + cross-SG shared memory reduction.
//
// Thread mapping (NQ=8, NW=32, NSG=4, 128 threads/TG):
//   ix = tiisg / 4  -> 0..7 (selects block within stride of 8)
//   il = tiisg % 4  -> 0..3 (selects which 8 bytes within 32-byte block)
//   Stride = NW/4 = 8 blocks per iteration
//
// Each threadgroup processes 1 output row (out_dim threadgroups).
// All 4 simdgroups cooperate on the SAME row via shared memory reduction.
//
// Dispatch: out_dim threadgroups, 128 threads each (4 simdgroups)
// ============================================================================

kernel void ffn_fused_gate_up_swiglu_q8_0_deferred(
    device const uchar* w_gate_q8   [[buffer(0)]],   // gate weights Q8_0 [inter_dim, hidden_dim]
    device const float* x           [[buffer(1)]],   // normed input [hidden_dim]
    device float*       out         [[buffer(2)]],   // output [inter_dim] (SwiGLU result)
    constant uint&      in_dim      [[buffer(3)]],   // hidden_dim
    constant uint&      out_dim     [[buffer(4)]],   // inter_dim
    device const uchar* w_up_q8     [[buffer(5)]],   // up weights Q8_0 [inter_dim, hidden_dim]
    uint tgpig [[threadgroup_position_in_grid]],
    uint tiisg [[thread_index_in_simdgroup]],
    uint sgitg [[simdgroup_index_in_threadgroup]])
{
    uint row = tgpig;
    if (row >= out_dim) return;

    const uint Q8_BLOCK_SIZE = 34;
    uint num_blocks = in_dim >> 5;  // in_dim / 32
    uint row_bytes = num_blocks * Q8_BLOCK_SIZE;

    // Thread mapping: each thread handles 8 contiguous elements within a block
    uint ix = tiisg / 4;   // 0..7: which block in stride of 8
    uint il = tiisg % 4;   // 0..3: which 8-byte quarter within 32-byte data

    device const uchar* gate_row_ptr = w_gate_q8 + row * row_bytes;
    device const uchar* up_row_ptr   = w_up_q8   + row * row_bytes;

    float gate_sum = 0.0f;
    float up_sum   = 0.0f;

    // Each simdgroup starts at a different offset and strides by NSG * 8 blocks
    // NSG=4 simdgroups, each strides 8 blocks -> total stride = 32 blocks/iter
    for (uint ib = sgitg * 8 + ix; ib < num_blocks; ib += 32) {
        // Load 8 x-values for this thread's quarter of the block
        uint x_base = ib * 32 + il * 8;
        float yl[8];
        #pragma clang loop unroll(full)
        for (uint i = 0; i < 8; i++) {
            yl[i] = x[x_base + i];
        }

        // Gate weights: read scale + 8 int8 values
        device const uchar* gate_bp = gate_row_ptr + ib * Q8_BLOCK_SIZE;
        half gate_scale = as_type<half>(*(device const ushort*)gate_bp);
        device const char* gate_qs = (device const char*)(gate_bp + 2) + il * 8;
        float gate_dot = 0.0f;
        #pragma clang loop unroll(full)
        for (uint i = 0; i < 8; i++) {
            gate_dot += float(gate_qs[i]) * yl[i];
        }
        gate_sum += gate_dot * float(gate_scale);

        // Up weights: same x-values, different weight row
        device const uchar* up_bp = up_row_ptr + ib * Q8_BLOCK_SIZE;
        half up_scale = as_type<half>(*(device const ushort*)up_bp);
        device const char* up_qs = (device const char*)(up_bp + 2) + il * 8;
        float up_dot = 0.0f;
        #pragma clang loop unroll(full)
        for (uint i = 0; i < 8; i++) {
            up_dot += float(up_qs[i]) * yl[i];
        }
        up_sum += up_dot * float(up_scale);
    }

    // Final reduction: simd_sum within each simdgroup (just 1 call each!)
    gate_sum = simd_sum(gate_sum);
    up_sum   = simd_sum(up_sum);

    // Cross-simdgroup reduction via shared memory
    threadgroup float shmem[8];  // [0..3] for gate, [4..7] for up

    if (tiisg == 0) {
        shmem[sgitg]     = gate_sum;
        shmem[sgitg + 4] = up_sum;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    // Thread 0 of simdgroup 0 does final reduction + SwiGLU
    if (sgitg == 0 && tiisg == 0) {
        float g = shmem[0] + shmem[1] + shmem[2] + shmem[3];
        float u = shmem[4] + shmem[5] + shmem[6] + shmem[7];
        float sigmoid = 1.0f / (1.0f + exp(-g));
        out[row] = g * sigmoid * u;
    }
}

// ============================================================================
// ffn_fused_gate_up_swiglu_q4_0: Fused Gate+Up+SwiGLU for Q4_0 decode
//
// Identical structure to Q8_0 fused kernel but with Q4_0 dequantization.
// Q4_0 block: 18 bytes (2 byte f16 scale + 16 bytes of packed 4-bit values)
// Each byte holds 2 elements: low nibble (even lane), high nibble (odd lane).
// Dequant: (float(nibble) - 8.0) * scale
//
// Dispatch: ceil(inter_dim/4) threadgroups, 128 threads each (4 simdgroups)
// Each simdgroup handles 1 output row.
// Zero threadgroup memory required.
// ============================================================================

kernel void ffn_fused_gate_up_swiglu_q4_0(
    device const uchar* w_gate_q4   [[buffer(0)]],   // gate weights Q4_0 [inter_dim, hidden_dim]
    device const float* x           [[buffer(1)]],   // normed input [hidden_dim]
    device float*       out         [[buffer(2)]],   // output [inter_dim] (SwiGLU result)
    constant uint&      in_dim      [[buffer(3)]],   // hidden_dim
    constant uint&      out_dim     [[buffer(4)]],   // inter_dim
    device const uchar* w_up_q4     [[buffer(5)]],   // up weights Q4_0 [inter_dim, hidden_dim]
    uint row_group                  [[threadgroup_position_in_grid]],
    uint lane                       [[thread_index_in_simdgroup]],
    uint sg                         [[simdgroup_index_in_threadgroup]])
{
    uint row = row_group * 4 + sg;
    if (row >= out_dim) return;

    uint num_blocks = in_dim >> 5;  // in_dim / 32
    uint row_bytes = num_blocks * Q4_BLOCK_SIZE;

    // De-interleaved nibble mapping
    uint q4_byte = (lane < 16) ? lane : (lane - 16);
    bool q4_hi = (lane >= 16);

    // --- Gate matmul: dot(w_gate[row], x) ---
    device const uchar* gate_row_ptr = w_gate_q4 + row * row_bytes;
    float gate_sum = 0.0f;

    uint b = 0;
    for (; b + 3 < num_blocks; b += 4) {
        device const uchar* bp0 = gate_row_ptr + b * Q4_BLOCK_SIZE;
        device const uchar* bp1 = bp0 + Q4_BLOCK_SIZE;
        device const uchar* bp2 = bp1 + Q4_BLOCK_SIZE;
        device const uchar* bp3 = bp2 + Q4_BLOCK_SIZE;
        half s0 = as_type<half>(*(device const ushort*)bp0);
        half s1 = as_type<half>(*(device const ushort*)bp1);
        half s2 = as_type<half>(*(device const ushort*)bp2);
        half s3 = as_type<half>(*(device const ushort*)bp3);
        uchar byte0 = (bp0 + 2)[q4_byte];
        uchar byte1 = (bp1 + 2)[q4_byte];
        uchar byte2 = (bp2 + 2)[q4_byte];
        uchar byte3 = (bp3 + 2)[q4_byte];
        int q0 = (q4_hi ? (byte0 >> 4) : (byte0 & 0xF)) - 8;
        int q1 = (q4_hi ? (byte1 >> 4) : (byte1 & 0xF)) - 8;
        int q2 = (q4_hi ? (byte2 >> 4) : (byte2 & 0xF)) - 8;
        int q3 = (q4_hi ? (byte3 >> 4) : (byte3 & 0xF)) - 8;
        float v0 = float(q0) * x[(b << 5) + lane];
        float v1 = float(q1) * x[((b+1) << 5) + lane];
        float v2 = float(q2) * x[((b+2) << 5) + lane];
        float v3 = float(q3) * x[((b+3) << 5) + lane];
        gate_sum += float(s0) * simd_sum(v0) + float(s1) * simd_sum(v1)
                  + float(s2) * simd_sum(v2) + float(s3) * simd_sum(v3);
    }
    for (; b < num_blocks; b++) {
        device const uchar* bp = gate_row_ptr + b * Q4_BLOCK_SIZE;
        half sc = as_type<half>(*(device const ushort*)bp);
        uchar byte_val = (bp + 2)[q4_byte];
        int q = (q4_hi ? (byte_val >> 4) : (byte_val & 0xF)) - 8;
        float val = float(q) * x[(b << 5) + lane];
        gate_sum += float(sc) * simd_sum(val);
    }

    // --- Up matmul: dot(w_up[row], x) ---
    device const uchar* up_row_ptr = w_up_q4 + row * row_bytes;
    float up_sum = 0.0f;

    b = 0;
    for (; b + 3 < num_blocks; b += 4) {
        device const uchar* bp0 = up_row_ptr + b * Q4_BLOCK_SIZE;
        device const uchar* bp1 = bp0 + Q4_BLOCK_SIZE;
        device const uchar* bp2 = bp1 + Q4_BLOCK_SIZE;
        device const uchar* bp3 = bp2 + Q4_BLOCK_SIZE;
        half s0 = as_type<half>(*(device const ushort*)bp0);
        half s1 = as_type<half>(*(device const ushort*)bp1);
        half s2 = as_type<half>(*(device const ushort*)bp2);
        half s3 = as_type<half>(*(device const ushort*)bp3);
        uchar byte0 = (bp0 + 2)[q4_byte];
        uchar byte1 = (bp1 + 2)[q4_byte];
        uchar byte2 = (bp2 + 2)[q4_byte];
        uchar byte3 = (bp3 + 2)[q4_byte];
        int q0 = (q4_hi ? (byte0 >> 4) : (byte0 & 0xF)) - 8;
        int q1 = (q4_hi ? (byte1 >> 4) : (byte1 & 0xF)) - 8;
        int q2 = (q4_hi ? (byte2 >> 4) : (byte2 & 0xF)) - 8;
        int q3 = (q4_hi ? (byte3 >> 4) : (byte3 & 0xF)) - 8;
        float v0 = float(q0) * x[(b << 5) + lane];
        float v1 = float(q1) * x[((b+1) << 5) + lane];
        float v2 = float(q2) * x[((b+2) << 5) + lane];
        float v3 = float(q3) * x[((b+3) << 5) + lane];
        up_sum += float(s0) * simd_sum(v0) + float(s1) * simd_sum(v1)
                + float(s2) * simd_sum(v2) + float(s3) * simd_sum(v3);
    }
    for (; b < num_blocks; b++) {
        device const uchar* bp = up_row_ptr + b * Q4_BLOCK_SIZE;
        half sc = as_type<half>(*(device const ushort*)bp);
        uchar byte_val = (bp + 2)[q4_byte];
        int q = (q4_hi ? (byte_val >> 4) : (byte_val & 0xF)) - 8;
        float val = float(q) * x[(b << 5) + lane];
        up_sum += float(sc) * simd_sum(val);
    }

    // --- SwiGLU: gate * sigmoid(gate) * up ---
    if (lane == 0) {
        float g = gate_sum;
        float sigmoid = 1.0f / (1.0f + exp(-g));
        out[row] = g * sigmoid * up_sum;
    }
}

// ============================================================================
// ffn_fused_gate_up_swiglu_q4_0_deferred: Fused Gate+Up+SwiGLU for Q4_0 decode
// with deferred reduction (mirrors Q8_0 deferred FFN pattern).
//
// 128 threads (4 simdgroups), 1 output row per threadgroup.
// Deferred accumulation: local sums across all blocks, ONE simd_sum at end.
// Q4_0 nibble dequantization for both gate and up weights.
//
// Dispatch: inter_dim threadgroups, 128 threads each
// ============================================================================

kernel void ffn_fused_gate_up_swiglu_q4_0_deferred(
    device const uchar* w_gate_q4   [[buffer(0)]],   // gate weights Q4_0 [inter_dim, hidden_dim]
    device const float* x           [[buffer(1)]],   // normed input [hidden_dim]
    device float*       out         [[buffer(2)]],   // output [inter_dim] (SwiGLU result)
    constant uint&      in_dim      [[buffer(3)]],   // hidden_dim
    constant uint&      out_dim     [[buffer(4)]],   // inter_dim
    device const uchar* w_up_q4     [[buffer(5)]],   // up weights Q4_0 [inter_dim, hidden_dim]
    uint tgpig [[threadgroup_position_in_grid]],
    uint tiisg [[thread_index_in_simdgroup]],
    uint sgitg [[simdgroup_index_in_threadgroup]])
{
    uint row = tgpig;
    if (row >= out_dim) return;

    uint num_blocks = in_dim >> 5;  // in_dim / 32
    uint row_bytes = num_blocks * Q4_BLOCK_SIZE;

    // Thread mapping: each thread handles 8 contiguous elements within a block
    uint ix = tiisg / 4;   // 0..7: which block in stride of 8
    uint il = tiisg % 4;   // 0..3: which 4-byte (8-element) quarter within 16-byte data

    device const uchar* gate_row_ptr = w_gate_q4 + row * row_bytes;
    device const uchar* up_row_ptr   = w_up_q4   + row * row_bytes;

    float gate_sum = 0.0f;
    float up_sum   = 0.0f;

    // Each simdgroup starts at a different offset and strides by NSG * 8 blocks
    // NSG=4 simdgroups, each strides 8 blocks -> total stride = 32 blocks/iter
    for (uint ib = sgitg * 8 + ix; ib < num_blocks; ib += 32) {
        // Load x-values for de-interleaved nibble positions
        uint block_base = ib * 32;
        float yl_lo[4], yl_hi[4];
        #pragma clang loop unroll(full)
        for (uint i = 0; i < 4; ++i) {
            yl_lo[i] = x[block_base + il * 4 + i];
            yl_hi[i] = x[block_base + il * 4 + 16 + i];
        }

        // Gate weights: read scale + 4 bytes (8 nibbles)
        device const uchar* gate_bp = gate_row_ptr + ib * Q4_BLOCK_SIZE;
        float gate_scale = float(as_type<half>(*(device const ushort*)gate_bp));
        device const uchar* gate_qdata = (device const uchar*)(gate_bp + 2) + il * 4;

        float gate_dot = 0.0f;
        #pragma clang loop unroll(full)
        for (uint i = 0; i < 4; ++i) {
            uchar byte_val = gate_qdata[i];
            float lo = float(byte_val & 0x0F) - 8.0f;
            float hi = float(byte_val >> 4) - 8.0f;
            gate_dot += lo * yl_lo[i] + hi * yl_hi[i];
        }
        gate_sum += gate_dot * gate_scale;

        // Up weights: same x-values, different weight row
        device const uchar* up_bp = up_row_ptr + ib * Q4_BLOCK_SIZE;
        float up_scale = float(as_type<half>(*(device const ushort*)up_bp));
        device const uchar* up_qdata = (device const uchar*)(up_bp + 2) + il * 4;

        float up_dot = 0.0f;
        #pragma clang loop unroll(full)
        for (uint i = 0; i < 4; ++i) {
            uchar byte_val = up_qdata[i];
            float lo = float(byte_val & 0x0F) - 8.0f;
            float hi = float(byte_val >> 4) - 8.0f;
            up_dot += lo * yl_lo[i] + hi * yl_hi[i];
        }
        up_sum += up_dot * up_scale;
    }

    // Final reduction: simd_sum within each simdgroup (just 1 call each!)
    gate_sum = simd_sum(gate_sum);
    up_sum   = simd_sum(up_sum);

    // Cross-simdgroup reduction via shared memory
    threadgroup float shmem[8];  // [0..3] for gate, [4..7] for up

    if (tiisg == 0) {
        shmem[sgitg]     = gate_sum;
        shmem[sgitg + 4] = up_sum;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    // Thread 0 of simdgroup 0 does final reduction + SwiGLU
    if (sgitg == 0 && tiisg == 0) {
        float g = shmem[0] + shmem[1] + shmem[2] + shmem[3];
        float u = shmem[4] + shmem[5] + shmem[6] + shmem[7];
        float sigmoid = 1.0f / (1.0f + exp(-g));
        out[row] = g * sigmoid * u;
    }
}

// ============================================================================
// ffn_fused_gate_up_swiglu_q4_1_deferred: Fused Gate+Up+SwiGLU for Q4_1 decode
// with deferred reduction (mirrors Q4_0 deferred FFN pattern).
//
// Q4_1 block layout: [f16 scale (2B)] [f16 min (2B)] [16 x uint8 nibbles (16B)] = 20 bytes/block
// dequant: value[i] = scale * nibble(i) + min
//
// 128 threads (4 simdgroups), 1 output row per threadgroup.
// Deferred accumulation: local sums across all blocks, ONE simd_sum at end.
//
// Dispatch: inter_dim threadgroups, 128 threads each
// ============================================================================

kernel void ffn_fused_gate_up_swiglu_q4_1_deferred(
    device const uchar* w_gate_q4   [[buffer(0)]],   // gate weights Q4_1 [inter_dim, hidden_dim]
    device const float* x           [[buffer(1)]],   // normed input [hidden_dim]
    device float*       out         [[buffer(2)]],   // output [inter_dim] (SwiGLU result)
    constant uint&      in_dim      [[buffer(3)]],   // hidden_dim
    constant uint&      out_dim     [[buffer(4)]],   // inter_dim
    device const uchar* w_up_q4     [[buffer(5)]],   // up weights Q4_1 [inter_dim, hidden_dim]
    uint tgpig [[threadgroup_position_in_grid]],
    uint tiisg [[thread_index_in_simdgroup]],
    uint sgitg [[simdgroup_index_in_threadgroup]])
{
    uint row = tgpig;
    if (row >= out_dim) return;

    uint num_blocks = in_dim >> 5;  // in_dim / 32
    uint row_bytes = num_blocks * Q4_1_BLOCK_SIZE;

    // Thread mapping: each thread handles 8 contiguous elements within a block
    uint ix = tiisg / 4;   // 0..7: which block in stride of 8
    uint il = tiisg % 4;   // 0..3: which 4-byte (8-element) quarter within 16-byte data

    device const uchar* gate_row_ptr = w_gate_q4 + row * row_bytes;
    device const uchar* up_row_ptr   = w_up_q4   + row * row_bytes;

    float gate_sum = 0.0f;
    float up_sum   = 0.0f;

    // Each simdgroup starts at a different offset and strides by NSG * 8 blocks
    // NSG=4 simdgroups, each strides 8 blocks -> total stride = 32 blocks/iter
    for (uint ib = sgitg * 8 + ix; ib < num_blocks; ib += 32) {
        // Load x-values for de-interleaved nibble positions
        uint block_base = ib * 32;
        float yl_lo[4], yl_hi[4];
        #pragma clang loop unroll(full)
        for (uint i = 0; i < 4; ++i) {
            yl_lo[i] = x[block_base + il * 4 + i];
            yl_hi[i] = x[block_base + il * 4 + 16 + i];
        }

        // Gate weights: Q4_1 block = [f16 scale, f16 min, 16B nibbles]
        device const uchar* gate_bp = gate_row_ptr + ib * Q4_1_BLOCK_SIZE;
        float gate_scale = float(as_type<half>(*(device const ushort*)gate_bp));
        float gate_min   = float(as_type<half>(*(device const ushort*)(gate_bp + 2)));
        device const uchar* gate_qdata = (device const uchar*)(gate_bp + 4) + il * 4;

        float gate_dot = 0.0f;
        float gate_sumy = 0.0f;
        #pragma clang loop unroll(full)
        for (uint i = 0; i < 4; ++i) {
            uchar byte_val = gate_qdata[i];
            float lo = float(byte_val & 0x0F);
            float hi = float(byte_val >> 4);
            gate_dot  += lo * yl_lo[i] + hi * yl_hi[i];
            gate_sumy += yl_lo[i] + yl_hi[i];
        }
        gate_sum += gate_dot * gate_scale + gate_sumy * gate_min;

        // Up weights: same x-values, different weight row
        device const uchar* up_bp = up_row_ptr + ib * Q4_1_BLOCK_SIZE;
        float up_scale = float(as_type<half>(*(device const ushort*)up_bp));
        float up_min   = float(as_type<half>(*(device const ushort*)(up_bp + 2)));
        device const uchar* up_qdata = (device const uchar*)(up_bp + 4) + il * 4;

        float up_dot = 0.0f;
        float up_sumy = 0.0f;
        #pragma clang loop unroll(full)
        for (uint i = 0; i < 4; ++i) {
            uchar byte_val = up_qdata[i];
            float lo = float(byte_val & 0x0F);
            float hi = float(byte_val >> 4);
            up_dot  += lo * yl_lo[i] + hi * yl_hi[i];
            up_sumy += yl_lo[i] + yl_hi[i];
        }
        up_sum += up_dot * up_scale + up_sumy * up_min;
    }

    // Final reduction: simd_sum within each simdgroup (just 1 call each!)
    gate_sum = simd_sum(gate_sum);
    up_sum   = simd_sum(up_sum);

    // Cross-simdgroup reduction via shared memory
    threadgroup float shmem[8];  // [0..3] for gate, [4..7] for up

    if (tiisg == 0) {
        shmem[sgitg]     = gate_sum;
        shmem[sgitg + 4] = up_sum;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    // Thread 0 of simdgroup 0 does final reduction + SwiGLU
    if (sgitg == 0 && tiisg == 0) {
        float g = shmem[0] + shmem[1] + shmem[2] + shmem[3];
        float u = shmem[4] + shmem[5] + shmem[6] + shmem[7];
        float sigmoid = 1.0f / (1.0f + exp(-g));
        out[row] = g * sigmoid * u;
    }
}

// ============================================================================
// ffn_fused_gate_up_swiglu_f16_deferred: Fused Gate+Up+SwiGLU for F16 decode
// with deferred reduction (mirrors Q8_0 deferred FFN pattern).
//
// F16 weights: dense half-precision, no block structure.
// Each row of gate/up weights is in_dim contiguous half values.
//
// 128 threads (4 simdgroups), 1 output row per threadgroup.
// Deferred accumulation: local sums across entire row, ONE simd_sum at end.
//
// Dispatch: inter_dim threadgroups, 128 threads each
// ============================================================================

kernel void ffn_fused_gate_up_swiglu_f16_deferred(
    device const half*  w_gate_f16  [[buffer(0)]],   // gate weights F16 [inter_dim, hidden_dim]
    device const float* x           [[buffer(1)]],   // normed input [hidden_dim]
    device float*       out         [[buffer(2)]],   // output [inter_dim] (SwiGLU result)
    constant uint&      in_dim      [[buffer(3)]],   // hidden_dim
    constant uint&      out_dim     [[buffer(4)]],   // inter_dim
    device const half*  w_up_f16    [[buffer(5)]],   // up weights F16 [inter_dim, hidden_dim]
    uint tgpig [[threadgroup_position_in_grid]],
    uint tiisg [[thread_index_in_simdgroup]],
    uint sgitg [[simdgroup_index_in_threadgroup]])
{
    uint row = tgpig;
    if (row >= out_dim) return;

    const uint NSG = 4;
    const uint NW = 32;
    const uint tid = sgitg * NW + tiisg;
    const uint total_threads = NSG * NW;  // 128

    device const half* gate_row = w_gate_f16 + row * in_dim;
    device const half* up_row   = w_up_f16   + row * in_dim;

    float gate_sum = 0.0f;
    float up_sum   = 0.0f;

    for (uint j = tid; j < in_dim; j += total_threads) {
        float xv = x[j];
        gate_sum += float(gate_row[j]) * xv;
        up_sum   += float(up_row[j])   * xv;
    }

    // Final reduction: simd_sum within each simdgroup
    gate_sum = simd_sum(gate_sum);
    up_sum   = simd_sum(up_sum);

    // Cross-simdgroup reduction via shared memory
    threadgroup float shmem[8];  // [0..3] for gate, [4..7] for up

    if (tiisg == 0) {
        shmem[sgitg]     = gate_sum;
        shmem[sgitg + 4] = up_sum;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    // Thread 0 of simdgroup 0 does final reduction + SwiGLU
    if (sgitg == 0 && tiisg == 0) {
        float g = shmem[0] + shmem[1] + shmem[2] + shmem[3];
        float u = shmem[4] + shmem[5] + shmem[6] + shmem[7];
        float sigmoid = 1.0f / (1.0f + exp(-g));
        out[row] = g * sigmoid * u;
    }
}

// ============================================================================
// argmax: GPU-side greedy sampling (single threadgroup, 256 threads)
//
// Finds the index of the maximum element in logits[0..n).
// Eliminates 128 KB logits readback -- only 4 bytes (u32 token ID) returned.
//
// Launch: 1 threadgroup, 256 threads.
// ============================================================================

kernel void argmax(
    device const float* logits [[buffer(0)]],
    device uint*        result [[buffer(1)]],
    constant uint&      n      [[buffer(2)]],
    uint tid        [[thread_index_in_threadgroup]],
    uint simd_lane  [[thread_index_in_simdgroup]],
    uint simd_group [[simdgroup_index_in_threadgroup]])
{
    // Each thread finds local max across strided elements
    float max_val = -INFINITY;
    uint max_idx = 0;
    uint tg_size = 256;
    for (uint i = tid; i < n; i += tg_size) {
        float v = logits[i];
        if (v > max_val) { max_val = v; max_idx = i; }
    }

    // SIMD reduction (32-wide on Apple Silicon)
    for (uint offset = 16; offset > 0; offset >>= 1) {
        float other_val = simd_shuffle_down(max_val, offset);
        uint other_idx = simd_shuffle_down(max_idx, offset);
        if (other_val > max_val) { max_val = other_val; max_idx = other_idx; }
    }

    // Cross-simdgroup reduction via threadgroup memory
    threadgroup float tg_vals[8];
    threadgroup uint tg_idxs[8];
    if (simd_lane == 0) {
        tg_vals[simd_group] = max_val;
        tg_idxs[simd_group] = max_idx;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    // Thread 0 does final serial reduction across 8 simdgroups
    if (tid == 0) {
        float best = tg_vals[0];
        uint best_idx = tg_idxs[0];
        for (uint i = 1; i < 8; i++) {
            if (tg_vals[i] > best) { best = tg_vals[i]; best_idx = tg_idxs[i]; }
        }
        result[0] = best_idx;
    }
}

// ============================================================================
// argmax_tiled_partial / argmax_tiled_reduce: two-pass GPU argmax that FILLS
// THE MACHINE (N threadgroups over contiguous slices), replacing the single-TG
// `argmax` above which streams all `n` logits through one of 80 cores (~2.9 GB/s,
// bandwidth-STARVED). Selected by the Rust greedy-decode dispatch.
//
// EXACTNESS (hard requirement): the selected token is BIT-IDENTICAL to the
// single-TG `argmax` for EVERY input, including exact ties, +/-Inf, NaN, and the
// all-(-Inf) case. The single-TG kernel's effective selection — derived from its
// 256-wide stride + strict `>` in the per-thread scan, the simd_shuffle_down
// reduction (lower lane wins on tie) and the serial cross-simdgroup scan (lower
// group wins on tie) — is exactly:
//     winner = argmin, over { i : logits[i] == globalmax }, of the key (i % 256, i)
// i.e. among all indices holding the maximum value, the one whose (index mod 256)
// is smallest, breaking further ties by smallest index. Both passes below compare
// with that SAME strict total order via `argmax_tiled_beats` (value DESC, then
// (i & 255) ASC, then i ASC). Because that order is a pure function of the index,
// the global winner is INDEPENDENT of how the logits are tiled/strided, so the
// two-pass result equals the single-TG result on every input. NaN never wins
// (both `>` and `==` are false for NaN, exactly as the single-TG `>` does); when
// nothing beats the -INFINITY sentinel (all -Inf / all NaN) the result is 0,
// matching the single-TG kernel's untouched `max_idx = 0`.
//
// tile_size = ceil(n / num_tiles); TG g owns [g*tile_size, min((g+1)*tile_size, n)).
// ============================================================================

// Strict composite tie-break: does candidate (vb, ib) beat the current (va, ia)?
inline bool argmax_tiled_beats(float vb, uint ib, float va, uint ia) {
    if (vb > va) return true;
    if (vb == va) {
        uint rb = ib & 255u;
        uint ra = ia & 255u;
        if (rb < ra) return true;
        if (rb == ra && ib < ia) return true;
    }
    return false;
}

kernel void argmax_tiled_partial(
    device const float* logits    [[buffer(0)]],
    device float*       part_val  [[buffer(1)]],
    device uint*        part_idx  [[buffer(2)]],
    constant uint&      n         [[buffer(3)]],
    constant uint&      tile_size [[buffer(4)]],
    uint tgid       [[threadgroup_position_in_grid]],
    uint tid        [[thread_index_in_threadgroup]],
    uint simd_lane  [[thread_index_in_simdgroup]],
    uint simd_group [[simdgroup_index_in_threadgroup]])
{
    uint start = tgid * tile_size;
    uint end   = min(start + tile_size, n);

    // Per-thread strided scan over this tile's contiguous slice.
    float max_val = -INFINITY;
    uint  max_idx = 0;
    for (uint i = start + tid; i < end; i += 256) {
        float v = logits[i];
        if (argmax_tiled_beats(v, i, max_val, max_idx)) { max_val = v; max_idx = i; }
    }

    // SIMD reduction (32-wide) with the composite comparator.
    for (uint offset = 16; offset > 0; offset >>= 1) {
        float ov = simd_shuffle_down(max_val, offset);
        uint  oi = simd_shuffle_down(max_idx, offset);
        if (argmax_tiled_beats(ov, oi, max_val, max_idx)) { max_val = ov; max_idx = oi; }
    }

    // Cross-simdgroup reduction via threadgroup memory.
    threadgroup float tg_vals[8];
    threadgroup uint  tg_idxs[8];
    if (simd_lane == 0) { tg_vals[simd_group] = max_val; tg_idxs[simd_group] = max_idx; }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (tid == 0) {
        float bv = tg_vals[0];
        uint  bi = tg_idxs[0];
        for (uint i = 1; i < 8; i++) {
            if (argmax_tiled_beats(tg_vals[i], tg_idxs[i], bv, bi)) { bv = tg_vals[i]; bi = tg_idxs[i]; }
        }
        part_val[tgid] = bv;
        part_idx[tgid] = bi;
    }
}

kernel void argmax_tiled_reduce(
    device const float* part_val  [[buffer(0)]],
    device const uint*  part_idx  [[buffer(1)]],
    device uint*        result    [[buffer(2)]],
    constant uint&      num_tiles [[buffer(3)]],
    uint tid        [[thread_index_in_threadgroup]],
    uint simd_lane  [[thread_index_in_simdgroup]],
    uint simd_group [[simdgroup_index_in_threadgroup]])
{
    // Reduce the <=256 pass-1 partials (part_idx holds GLOBAL indices, so the
    // (i & 255) residue key is the true logit residue — same total order as pass-1).
    float max_val = -INFINITY;
    uint  max_idx = 0;
    for (uint i = tid; i < num_tiles; i += 256) {
        float v   = part_val[i];
        uint  idx = part_idx[i];
        if (argmax_tiled_beats(v, idx, max_val, max_idx)) { max_val = v; max_idx = idx; }
    }

    for (uint offset = 16; offset > 0; offset >>= 1) {
        float ov = simd_shuffle_down(max_val, offset);
        uint  oi = simd_shuffle_down(max_idx, offset);
        if (argmax_tiled_beats(ov, oi, max_val, max_idx)) { max_val = ov; max_idx = oi; }
    }

    threadgroup float tg_vals[8];
    threadgroup uint  tg_idxs[8];
    if (simd_lane == 0) { tg_vals[simd_group] = max_val; tg_idxs[simd_group] = max_idx; }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (tid == 0) {
        float bv = tg_vals[0];
        uint  bi = tg_idxs[0];
        for (uint i = 1; i < 8; i++) {
            if (argmax_tiled_beats(tg_vals[i], tg_idxs[i], bv, bi)) { bv = tg_vals[i]; bi = tg_idxs[i]; }
        }
        result[0] = bi;
    }
}

// ============================================================================
// gpu_sampler: GPU-side temperature sampling with PARITY to the CPU sampler.
//
// Reproduces, BIT-FOR-BIT where the platform allows, the CPU reference
// `sample_logits` (crates/lumen-runtime/src/sampling.rs) for the temperature>0
// path with: repetition/presence/frequency penalties over a history window,
// temperature, softmax (max-subtract), and an inverse-CDF categorical draw.
// top_k / top_p / min_p are NOT implemented in this v1 kernel; the Rust caller
// gates the GPU-sampler path to require them unset (and routes to the CPU
// sampler otherwise), so this kernel is only ever invoked for the exact subset
// it reproduces.
//
// PARITY CONTRACT (matches sampling.rs precisely):
//   1. Penalties on RAW logits, BEFORE temperature, driven by a GPU-RESIDENT
//      FREQUENCY ARRAY `freq_arr[vocab]` (u32 occurrence count per token id over
//      the FULL history). For each token id `t` with freq_arr[t] = c > 0:
//         new = (logit[t] > 0 ? logit[t]/rep : logit[t]*rep)
//               - presence - freq*c
//      This is EXACTLY the CPU `apply_penalties`/`apply_penalty_one` over the
//      full-history `state.freq` map: one application per UNIQUE token id (the
//      array has one slot per id, so a token seen N times is penalised once for
//      `rep` and by `freq*N` for the count term — identical to the freq map).
//      The parallel per-index application is order-independent and bit-exact.
//      The array is GPU-resident so a pipelined CB(k+1) sees CB(k)'s freshly
//      appended token WITHOUT any CPU round-trip (the FIFO queue orders the
//      append-before-read), which is what lets the SAMPLED path pipeline at the
//      same depth-2 as the greedy argmax chain. The Rust caller gates this path
//      to `repeat_last_n == None` (full-history window) so the array semantics
//      match; a windowed penalty falls back to the CPU sampler.
//      After selecting the token `sel`, the kernel does `freq_arr[sel] += 1`
//      (single thread) so the NEXT CB's penalty phase sees it -- the GPU-side
//      analogue of SamplerState::record / the history ring (checklist 5 + 7).
//   2. Temperature: logit[i] *= (1.0/temperature) for ALL i (after penalties).
//   3. Softmax max: max over ALL temperature-scaled logits. Max is associative
//      and commutative for finite f32, so the parallel reduction is EXACT
//      (bit-identical to the CPU's sequential/NEON max).
//   4. exp: exp_i = precise::exp(scaled_i - max), elementwise in parallel. exp
//      is order-independent; the only residual non-determinism vs the CPU is
//      the transcendental implementation itself (Metal precise::exp vs Rust
//      std f32 exp), which can differ by <=1 ULP per element. This is the ONE
//      place true bit-exactness is not guaranteed; it only matters at a genuine
//      near-tie where r ~ cumsum boundary (characterized by the parity test).
//   5. sum: SUM of exp_i computed by a SINGLE THREAD, SEQUENTIALLY i=0..n, in
//      f32 — reproducing the CPU softmax Phase-2 accumulation order exactly
//      (the CPU does a naive sequential f32 add, NOT Kahan; a GPU tree-reduce
//      would round differently and shift cumsum, so we MUST do this serially).
//   6. inv_sum = 1.0/sum (computed once, as the CPU does).
//   7. draw: ONE rng.next_f32() (xorshift64 13/7/17; r = (next_u64()>>40) *
//      (1/2^24)); then a SINGLE THREAD walks cumsum += exp_i*inv_sum (the CPU
//      normalizes p_i = exp_i*inv_sum THEN accumulates p_i, so we multiply
//      per-term BEFORE adding — NOT (sum exp)*inv_sum) and returns the first i
//      with `r < cumsum` (STRICT <). Sequential to match sample_categorical's
//      accumulation order exactly. Fall through to (n-1) on FP slack.
//   8. Degenerate guards: if max is non-finite OR sum <= f32::EPSILON, the CPU
//      fills a uniform distribution (p=1/n). We reproduce: a uniform draw picks
//      floor(r*n) clamped (equivalently the first i with r < (i+1)/n). The CPU
//      STILL consumes exactly one rng draw in these branches (softmax fills
//      uniform, then sample_categorical draws once), so draw-count parity holds.
//
// RNG STATE RING: rng_state_in[0] holds this step's u64 xorshift state. The
// kernel performs exactly ONE next_u64() (advancing the state once) and writes
// the ADVANCED state to rng_state_out[0]. The Rust driver wires these to a
// state ring (step%R -> (step+1)%R) exactly like the token ring, so the
// post-token RNG state advances by precisely one draw per token (draw-count
// parity, checklist item 2).
//
// f32::EPSILON in Rust = 1.19209290e-07. Matched as a literal below.
//
// Launch: 1 threadgroup, 256 threads (single-TG finalizer, like argmax).
// ============================================================================

constant float LUMEN_F32_EPSILON = 1.1920929e-07f;

kernel void gpu_sampler(
    device float*        logits        [[buffer(0)]],  // [n] in/out scratch
    device uint*         token_out     [[buffer(1)]],  // [1] selected token id
    constant uint&       n             [[buffer(2)]],  // vocab size
    constant float&      inv_temp      [[buffer(3)]],  // 1.0 / temperature
    device atomic_uint*  freq_arr      [[buffer(4)]],  // [n] per-id history count
    constant uint&       pen_active    [[buffer(5)]],  // 1 if any penalty active
    constant float&      rep           [[buffer(6)]],  // repetition_penalty
    constant float&      presence      [[buffer(7)]],  // presence_penalty
    constant float&      freq          [[buffer(8)]],  // frequency_penalty
    device const ulong*  rng_state_in  [[buffer(9)]],  // [1] xorshift64 state
    device ulong*        rng_state_out [[buffer(10)]], // [1] advanced state
    uint tid        [[thread_index_in_threadgroup]],
    uint simd_lane  [[thread_index_in_simdgroup]],
    uint simd_group [[simdgroup_index_in_threadgroup]])
{
    const uint TG = 256u;

    // ----- Phase A: penalties on RAW logits, driven by the GPU freq array. ----
    // One application per UNIQUE token id (the array has one slot per id), so it
    // is bit-identical to the CPU loop over the full-history freq map. Parallel
    // over vocab; each index is touched by exactly one thread (order-independent).
    // freq_arr is atomic_uint only so the post-select append (atomic_fetch_add)
    // is well-defined; here we read it relaxed (the FIFO queue guarantees the
    // prior CB's append is visible, and within this CB no append has happened
    // yet, so a plain relaxed load is correct and race-free).
    if (pen_active != 0u) {
        const bool rep_active = fabs(rep - 1.0f) >= LUMEN_F32_EPSILON;
        for (uint i = tid; i < n; i += TG) {
            uint c = atomic_load_explicit(&freq_arr[i], memory_order_relaxed);
            if (c == 0u) { continue; }
            float v = logits[i];
            float nv = v;
            if (rep_active) {
                nv = (v > 0.0f) ? (v / rep) : (v * rep);
            }
            nv = nv - presence;
            nv = nv - freq * (float)c;
            logits[i] = nv;
        }
        threadgroup_barrier(mem_flags::mem_device);
    }

    // ----- Phase B1: temperature scale + max over ALL logits (parallel). -----
    // We fold the temperature multiply into the max scan; the per-element
    // scaled value is recomputed in B2 (cheap mul) so we never need a second
    // device buffer. Max is exact regardless of reduction order.
    float local_max = -INFINITY;
    for (uint i = tid; i < n; i += TG) {
        float s = logits[i] * inv_temp;
        if (s > local_max) { local_max = s; }
    }
    local_max = simd_max(local_max);
    threadgroup float tg_max[8];
    if (simd_lane == 0) { tg_max[simd_group] = local_max; }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    threadgroup float max_val_sh;
    if (tid == 0) {
        float m = tg_max[0];
        for (uint i = 1; i < 8; i++) { if (tg_max[i] > m) { m = tg_max[i]; } }
        max_val_sh = m;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    float max_val = max_val_sh;

    // Degenerate guard #1: non-finite max -> CPU fills uniform (1/n) then draws
    // once. Reproduce a single-draw uniform pick. (isfinite covers +/-inf+nan.)
    bool max_finite = isfinite(max_val);

    // ----- Phase B2: exp_i = precise::exp(scaled_i - max) into logits[i]. -----
    // Only when max is finite (else logits content is irrelevant; uniform path).
    if (max_finite) {
        for (uint i = tid; i < n; i += TG) {
            float s = logits[i] * inv_temp;
            logits[i] = precise::exp(s - max_val);
        }
    }
    threadgroup_barrier(mem_flags::mem_device);

    // ----- Phase C: SINGLE-THREAD sequential sum + inverse-CDF walk. -----
    // This is the parity-critical core: the CPU sums exp sequentially (i=0..n)
    // and walks the normalized cumsum sequentially. We reproduce BOTH on one
    // thread so the f32 rounding order is identical.
    if (tid == 0) {
        // RNG: exactly one next_u64 -> next_f32 (== CPU sample_categorical).
        ulong x = rng_state_in[0];
        x ^= x << 13;
        x ^= x >> 7;
        x ^= x << 17;
        rng_state_out[0] = x;                 // advanced state (draw-count parity)
        // next_f32: (next_u64() >> 40) as f32 * (1/2^24).
        float r = (float)(x >> 40) * (1.0f / (float)(1u << 24));

        uint sel;
        if (!max_finite) {
            // Uniform fallback: probs all 1/n; cumsum walk gives first i with
            // r < (i+1)/n  <=>  i = floor(r*n) (r in [0,1)). Clamp to n-1.
            float fn = (float)n;
            uint i = (uint)(r * fn);
            sel = (i >= n) ? (n - 1u) : i;
        } else {
            // Sequential sum of exp, matching softmax Phase-2 order.
            float sum = 0.0f;
            for (uint i = 0; i < n; i++) { sum += logits[i]; }
            if (sum <= LUMEN_F32_EPSILON) {
                // Degenerate guard #2: CPU fills uniform then draws (already
                // drew above). Same uniform pick as the non-finite branch.
                float fn = (float)n;
                uint i = (uint)(r * fn);
                sel = (i >= n) ? (n - 1u) : i;
            } else {
                float inv_sum = 1.0f / sum;
                // Inverse-CDF walk: p_i = exp_i*inv_sum (per-term rounded),
                // cumsum += p_i, first i with r < cumsum. STRICT <.
                float cumsum = 0.0f;
                sel = n - 1u;                  // FP-slack fall-through
                for (uint i = 0; i < n; i++) {
                    cumsum += logits[i] * inv_sum;
                    if (r < cumsum) { sel = i; break; }
                }
            }
        }
        token_out[0] = sel;
        // GPU-side SamplerState::record: append the chosen token to the history
        // freq array so the NEXT pipelined CB's penalty phase sees it. Ordered
        // before the next CB by the single FIFO queue (no event needed, same
        // invariant the greedy token-ring chain relies on).
        if (pen_active != 0u) {
            atomic_fetch_add_explicit(&freq_arr[sel], 1u, memory_order_relaxed);
        }
    }
}

// ============================================================================
// gpu_sampler_fast: latency-hiding variant of gpu_sampler.
//
// Identical pipeline + identical RNG/penalty semantics, but the two O(vocab)
// reductions (the softmax sum and the inverse-CDF walk) are made FAST by
// hiding device-memory latency with all 256 threads instead of running a single
// thread serially over ~248k device loads (which is latency-bound: ~14 ms).
//
// HOW IT STAYS PARITY-FAITHFUL:
//   * Penalties, max, and exp are computed EXACTLY as in gpu_sampler (max is
//     order-independent => bit-exact; exp is the same precise::exp).
//   * The SUM is computed as a HIERARCHICAL block sum: thread t sums its
//     contiguous block [t*B, (t+1)*B) SEQUENTIALLY (in-order, matching the CPU
//     accumulation order WITHIN the block), producing block_sum[t]; then one
//     thread sums the 256 block sums SEQUENTIALLY in block order. This is NOT
//     bit-identical to the CPU's single continuous running sum (a block boundary
//     restarts the local accumulator at 0 instead of carrying the running
//     total), but the difference is the SAME O(1e-6) magnitude as the exp
//     transcendental difference that gpu_sampler already incurs, so it does not
//     change the selected token except at a genuine sub-ULP near-tie. (The
//     parity test asserts this empirically against the CPU reference.)
//   * The WALK reuses the per-block sums: a single thread scans the 256 block
//     sums to find the block B that contains the target (running block-prefix
//     first exceeds r), carrying the exact block-prefix; then it walks WITHIN
//     block B (<= ~970 elements) sequentially, exactly as the CPU walk would,
//     starting from that prefix. Bounded single-thread work (~256 + ~970 loads)
//     instead of up to ~248k. Uses the SAME normalized per-term accumulation
//     (cumsum += exp_i * inv_sum) and the SAME strict `r < cumsum` test.
//
// The block boundaries are deterministic (B = ceil(n/256)), so the reduction
// order is fixed run-to-run (determinism preserved). Launch: 1 TG, 256 threads.
// ============================================================================

kernel void gpu_sampler_fast(
    device float*        logits        [[buffer(0)]],
    device uint*         token_out     [[buffer(1)]],
    constant uint&       n             [[buffer(2)]],
    constant float&      inv_temp      [[buffer(3)]],
    device atomic_uint*  freq_arr      [[buffer(4)]],
    constant uint&       pen_active    [[buffer(5)]],
    constant float&      rep           [[buffer(6)]],
    constant float&      presence      [[buffer(7)]],
    constant float&      freq          [[buffer(8)]],
    device const ulong*  rng_state_in  [[buffer(9)]],
    device ulong*        rng_state_out [[buffer(10)]],
    uint tid        [[thread_index_in_threadgroup]],
    uint simd_lane  [[thread_index_in_simdgroup]],
    uint simd_group [[simdgroup_index_in_threadgroup]])
{
    const uint TG = 256u;
    // Contiguous block size per thread (covers all n; last block may be short).
    const uint B = (n + TG - 1u) / TG;

    // ----- Phase A: penalties (parallel; identical to gpu_sampler). -----
    if (pen_active != 0u) {
        const bool rep_active = fabs(rep - 1.0f) >= LUMEN_F32_EPSILON;
        for (uint i = tid; i < n; i += TG) {
            uint c = atomic_load_explicit(&freq_arr[i], memory_order_relaxed);
            if (c == 0u) { continue; }
            float v = logits[i];
            float nv = v;
            if (rep_active) { nv = (v > 0.0f) ? (v / rep) : (v * rep); }
            nv = nv - presence;
            nv = nv - freq * (float)c;
            logits[i] = nv;
        }
        threadgroup_barrier(mem_flags::mem_device);
    }

    // ----- Phase B1: temperature + max (parallel reduction; exact). -----
    float local_max = -INFINITY;
    for (uint i = tid; i < n; i += TG) {
        float s = logits[i] * inv_temp;
        if (s > local_max) { local_max = s; }
    }
    local_max = simd_max(local_max);
    threadgroup float tg_max[8];
    if (simd_lane == 0) { tg_max[simd_group] = local_max; }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    threadgroup float max_val_sh;
    if (tid == 0) {
        float m = tg_max[0];
        for (uint i = 1; i < 8; i++) { if (tg_max[i] > m) { m = tg_max[i]; } }
        max_val_sh = m;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    float max_val = max_val_sh;
    bool max_finite = isfinite(max_val);

    // ----- Phase B2: exp into logits[i] (parallel; identical). -----
    if (max_finite) {
        for (uint i = tid; i < n; i += TG) {
            float s = logits[i] * inv_temp;
            logits[i] = precise::exp(s - max_val);
        }
    }
    threadgroup_barrier(mem_flags::mem_device);

    // ----- Phase C-sum: hierarchical block sum (parallel block, serial merge). -
    // Each thread sums its contiguous block in order (matching the CPU
    // accumulation order WITHIN the block). Latency across the 256 blocks is
    // hidden because the threads issue their loads concurrently.
    threadgroup float block_sum[256];
    if (max_finite) {
        uint start = tid * B;
        uint end = min(start + B, n);
        float bs = 0.0f;
        for (uint i = start; i < end; i++) { bs += logits[i]; }
        block_sum[tid] = bs;
    } else {
        block_sum[tid] = 0.0f;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    // tid 0 merges the block sums (sequential, block order) into the total, does
    // the RNG draw, and computes inv_sum + the degenerate flags. Shared out.
    threadgroup float inv_sum_sh;
    threadgroup float r_sh;
    threadgroup uint  sel_sh;       // final token (set here for degenerate paths)
    threadgroup uint  done_sh;      // 1 if a degenerate/uniform path already set sel
    if (tid == 0) {
        ulong x = rng_state_in[0];
        x ^= x << 13; x ^= x >> 7; x ^= x << 17;
        rng_state_out[0] = x;
        float r = (float)(x >> 40) * (1.0f / (float)(1u << 24));
        r_sh = r;
        done_sh = 0u;
        inv_sum_sh = 0.0f;
        if (!max_finite) {
            float fn = (float)n;
            uint i = (uint)(r * fn);
            sel_sh = (i >= n) ? (n - 1u) : i;
            done_sh = 1u;
        } else {
            float sum = 0.0f;
            for (uint t = 0; t < TG; t++) { sum += block_sum[t]; }
            if (sum <= LUMEN_F32_EPSILON) {
                float fn = (float)n;
                uint i = (uint)(r * fn);
                sel_sh = (i >= n) ? (n - 1u) : i;
                done_sh = 1u;
            } else {
                inv_sum_sh = 1.0f / sum;
            }
        }
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    // If not already resolved, do the inverse-CDF walk in NORMALIZED space.
    // To keep the per-element normalized accumulation the CPU uses (p_i =
    // exp_i*inv_sum accumulated term-by-term) we recompute each block's
    // NORMALIZED partial now that inv_sum is known, then a single thread finds
    // the target block via the normalized block-prefix and walks WITHIN that
    // block per-element from the carried prefix. Both the block-partials and the
    // within-block walk use the same `+= logits[i]*inv_sum` term form, so the
    // accumulation style matches the CPU (modulo block-boundary re-association,
    // the same O(1e-6) class as the exp difference).
    if (done_sh == 0u) {
        float inv_sum = inv_sum_sh;
        // Parallel: per-block normalized partial.
        threadgroup float block_norm[256];
        uint start = tid * B;
        uint end = min(start + B, n);
        float bn = 0.0f;
        for (uint i = start; i < end; i++) { bn += logits[i] * inv_sum; }
        block_norm[tid] = bn;
        threadgroup_barrier(mem_flags::mem_threadgroup);

        if (tid == 0) {
            float r = r_sh;
            // Find target block via normalized block-prefix (sequential).
            float cumsum = 0.0f;
            uint b = 0u;
            for (; b < TG; b++) {
                float next = cumsum + block_norm[b];
                if (r < next) { break; }
                cumsum = next;
            }
            uint sel = n - 1u;     // FP-slack fall-through (r past last block)
            if (b < TG) {
                uint s2 = b * B;
                uint e2 = min(s2 + B, n);
                for (uint i = s2; i < e2; i++) {
                    cumsum += logits[i] * inv_sum;
                    if (r < cumsum) { sel = i; break; }
                }
            }
            sel_sh = sel;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    // tid 0 writes the result + appends to the history freq array.
    if (tid == 0) {
        uint sel = sel_sh;
        token_out[0] = sel;
        if (pen_active != 0u) {
            atomic_fetch_add_explicit(&freq_arr[sel], 1u, memory_order_relaxed);
        }
    }
}

// ============================================================================
// bias_add: Element-wise bias addition for single-token decode
//
// Adds a bias vector to the output of a matmul projection:
//   data[i] += bias[i]  for i in 0..n
//
// Used for QKV bias in Qwen2-family models. Zero-cost for models without bias
// (dispatch is conditional on the presence of bias tensors).
// Dispatch: ceil(n / 256) threadgroups, 256 threads each.
// ============================================================================

kernel void bias_add(
    device float*       data [[buffer(0)]],
    device const float* bias [[buffer(1)]],
    constant uint&      n    [[buffer(2)]],
    uint tid                 [[thread_position_in_grid]])
{
    if (tid < n) {
        data[tid] += bias[tid];
    }
}

// ============================================================================
// bias_add_batched: Broadcast bias addition for batched prefill
//
// For a [rows, cols] activation matrix, adds bias[j] to every row:
//   data[i * cols + j] += bias[j]  for all (i, j)
//
// total = rows * cols. The bias vector (length = cols) is broadcast across
// all rows via modular indexing.
// Dispatch: ceil(total / 256) threadgroups, 256 threads each.
// ============================================================================

kernel void bias_add_batched(
    device float*       data  [[buffer(0)]],
    device const float* bias  [[buffer(1)]],
    constant uint&      cols  [[buffer(2)]],
    constant uint&      total [[buffer(3)]],
    uint tid                  [[thread_position_in_grid]])
{
    if (tid < total) {
        data[tid] += bias[tid % cols];
    }
}

// ============================================================================
// deinterleave_qkv: Split fused [M][qkv_dim] output into separate Q, K, V buffers
//
// Fused QKV GEMM produces [M][qkv_dim] where each row is [Q|K|V] concatenated.
// Downstream kernels expect separate [M][q_dim], [M][kv_dim], [M][kv_dim] buffers.
// This kernel copies each component to its target buffer with correct stride.
//
// Thread mapping: 1D grid, total_elements = M * qkv_dim
// Each thread copies one float from the fused buffer to the correct output buffer.
// ============================================================================

kernel void deinterleave_qkv(
    device const float* qkv_fused  [[buffer(0)]],  // [M, qkv_dim] fused output
    device float*       Q          [[buffer(1)]],   // [M, q_dim] output
    device float*       K          [[buffer(2)]],   // [M, kv_dim] output
    device float*       V          [[buffer(3)]],   // [M, kv_dim] output
    constant uint&      M          [[buffer(4)]],   // batch size
    constant uint&      q_dim      [[buffer(5)]],   // Q output dim
    constant uint&      kv_dim     [[buffer(6)]],   // K/V output dim
    constant uint&      qkv_dim    [[buffer(7)]],   // q_dim + 2*kv_dim
    uint tid                       [[thread_position_in_grid]])
{
    uint total = M * qkv_dim;
    if (tid >= total) return;

    uint row = tid / qkv_dim;
    uint col = tid % qkv_dim;
    float val = qkv_fused[tid];

    if (col < q_dim) {
        Q[row * q_dim + col] = val;
    } else if (col < q_dim + kv_dim) {
        K[row * kv_dim + (col - q_dim)] = val;
    } else {
        V[row * kv_dim + (col - q_dim - kv_dim)] = val;
    }
}

// ============================================================================
// MoE (Mixture of Experts) Kernels
// ============================================================================

// ============================================================================
// moe_router_softmax: Compute router logits, apply softmax, select top-K experts.
//
// For a single token's hidden state, computes the dot product against each
// expert's gating vector (one row of gate_weight), applies softmax over all
// experts, selects the top-K experts by weight, and renormalizes the selected
// weights to sum to 1.0.
//
// Optimized for small num_experts (e.g. 8 for Mixtral) with large hidden_dim
// (e.g. 4096). The threadgroup cooperatively reduces the dot products.
//
// buffer(0): hidden_state  [hidden_dim] float            — normalized input
// buffer(1): gate_weight   [num_experts * hidden_dim] float — router weights (row-major)
// buffer(2): expert_ids    [top_k] uint32                — OUTPUT: selected expert indices
// buffer(3): expert_weights [top_k] float                — OUTPUT: normalized routing weights
// buffer(4): hidden_dim (uint)
// buffer(5): num_experts (uint)
// buffer(6): top_k (uint)
//
// grid: (1, 1, 1), threadgroup: (min(256, hidden_dim), 1, 1)
// ============================================================================

